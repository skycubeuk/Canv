{
  "id": "daily-notes-watcher",
  "name": "Daily Notes Watcher",
  "version": "1.0.0",
  "engines": { "canv": "^1.0.0" },
  "description": "Phase 3 smoke fixture — activates only when the vault contains daily-notes/*.md.",
  "author": "canv-internal",
  "capabilities": ["notify", "ui"],
  "activationEvents": ["workspaceContains:daily-notes/*.md"],
