---
const features = [
  {
    title: 'Local-first',
    body: 'No backend, no telemetry. Your documents live on disk in a folder you choose. The app talks directly to your AI provider — nothing in the middle.',
  },
  {
    title: 'Pluggable AI',
    body: 'Anthropic Claude, OpenAI, and local Ollama. Bring your own keys. Switch providers per action. Run free local models when you do not want to spend.',
  },
  {
    title: 'Profile-driven',
    body: 'Fiction, Technical, and Factual profiles ship with prompts tuned for what they do. Pick one when you open a folder; switch any time. Or write your own.',
  },
];
---
<section class="features" aria-label="What Canv is">
  <div class="features-inner">
    <h2>What Canv is</h2>
    <div class="grid">
      {features.map((f) => (
        <article>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: 4rem 1.5rem;
    background: var(--canv-surface);
  }
  .features-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  h2 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 2rem;
    color: var(--canv-text);
    text-align: center;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  article {
    padding: 1.5rem;
    background: color-mix(in srgb, var(--canv-ink) 60%, transparent);
    border: 1px solid color-mix(in srgb, var(--canv-purple-500) 15%, transparent);
    border-radius: 0.75rem;
  }
  h3 {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--canv-purple-500);
  }
  p {
    margin: 0;
    color: var(--canv-muted);
    font-size: 0.975rem;
  }
</style>
