---
const RELEASES = 'https://github.com/skycubeuk/Canv/releases/latest';
const platforms = [
  {
    name: 'macOS',
    asset: 'Intel and Apple Silicon .dmg',
    note: 'Builds are unsigned. Right-click the app → Open to bypass Gatekeeper the first time.',
  },
  {
    name: 'Windows',
    asset: 'NSIS installer or portable .exe',
    note: 'SmartScreen warns "publisher unknown" — click More info → Run anyway.',
  },
  {
    name: 'Linux',
    asset: '.AppImage, .deb, .rpm',
    note: 'chmod +x the AppImage, or install the .deb / .rpm with your package manager.',
  },
];
---
<section id="download" class="download" aria-label="Download Canv">
  <div class="download-inner">
    <h2>Download</h2>
    <p class="lead">Free, open-source, no account. Builds for macOS, Windows, and Linux.</p>
    <div class="grid">
      {platforms.map((p) => (
        <article>
          <h3>{p.name}</h3>
          <p class="asset">{p.asset}</p>
          <a class="dl" href={RELEASES}>Download for {p.name}</a>
          <p class="note">{p.note}</p>
        </article>
      ))}
    </div>
    <p class="all-releases">
      <a href={RELEASES}>See all release artefacts on GitHub →</a>
    </p>
  </div>
</section>

<style>
  .download {
    padding: 4rem 1.5rem;
    background: var(--canv-surface);
  }
  .download-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }
  h2 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: var(--canv-text);
  }
  .lead {
    color: var(--canv-muted);
    margin: 0 0 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    text-align: left;
  }
  article {
    padding: 1.5rem;
    background: color-mix(in srgb, var(--canv-ink) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--canv-purple-500) 15%, transparent);
    border-radius: 0.75rem;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    color: var(--canv-text);
  }
  .asset {
    margin: 0 0 1rem;
    color: var(--canv-muted);
    font-size: 0.9rem;
  }
  .dl {
    display: inline-block;
    padding: 0.625rem 1rem;
    background: var(--canv-purple-500);
    color: white;
    border-radius: 0.375rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .dl:hover { background: var(--canv-purple-700); color: white; }
  .note {
    margin: 0;
    color: var(--canv-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .all-releases {
    margin-top: 2rem;
  }
</style>
