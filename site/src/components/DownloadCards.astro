---
import { LATEST_VERSION, ASSETS, downloadUrl, ALL_RELEASES_URL } from '../release-info';

const platforms = [
  {
    name: 'macOS',
    note: 'Builds are unsigned. Right-click the app → Open to bypass Gatekeeper the first time.',
    builds: ASSETS.macos,
  },
  {
    name: 'Windows',
    note: 'SmartScreen warns "publisher unknown" — click More info → Run anyway.',
    builds: ASSETS.windows,
  },
  {
    name: 'Linux',
    note: 'chmod +x the AppImage, or install the .deb / .rpm with your package manager.',
    builds: ASSETS.linux,
  },
];
---
<section id="download" class="download" aria-label="Download Canv">
  <div class="download-inner">
    <h2>Download</h2>
    <p class="lead">Free, open-source, no account. Builds for macOS, Windows, and Linux.</p>
    <p class="version">Latest version: <strong>v{LATEST_VERSION}</strong></p>
    <div class="grid">
      {platforms.map((p) => (
        <article>
          <h3>{p.name}</h3>
          <ul class="builds">
            {p.builds.map((b) => (
              <li>
                <a class="dl" href={downloadUrl(b.filename)}>{b.label}</a>
              </li>
            ))}
          </ul>
          <p class="note">{p.note}</p>
        </article>
      ))}
    </div>
    <p class="all-releases">
      <a href={ALL_RELEASES_URL}>All releases on GitHub →</a>
    </p>
  </div>
</section>

<style>
  .download {
    padding: 4rem 1.5rem;
    background: var(--canv-surface);
  }
  .download-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }
  h2 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--canv-text);
  }
  .lead {
    color: var(--canv-muted);
    margin: 0 0 0.5rem;
  }
  .version {
    color: var(--canv-muted);
    font-size: 0.9rem;
    margin: 0 0 2rem;
  }
  .version strong {
    color: var(--canv-purple-500);
    font-weight: 600;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    text-align: left;
    align-items: start;
  }
  article {
    padding: 1.5rem;
    background: color-mix(in srgb, var(--canv-ink) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--canv-purple-500) 15%, transparent);
    border-radius: 0.75rem;
  }
  h3 {
    margin: 0 0 1rem;
    font-size: 1.125rem;
    color: var(--canv-text);
  }
  .builds {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dl {
    display: block;
    padding: 0.625rem 1rem;
    background: var(--canv-purple-500);
    color: white;
    border-radius: 0.375rem;
    font-weight: 500;
    font-size: 0.95rem;
    text-align: center;
    transition: background 200ms;
  }
  .dl:hover { background: var(--canv-purple-700); color: white; }
  .note {
    margin: 0;
    color: var(--canv-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .all-releases {
    margin-top: 2rem;
  }
</style>
