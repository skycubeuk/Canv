{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "moduleResolution": "node16",
    "module": "node16",
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false
  },
  "include": ["electron/**/*.cjs"],
  "exclude": ["electron/**/*.test.cjs", "electron/site-libs/**"]
}
